# ── Firebase project: sira-20fae (existing project, do not create another) ──
# Copy to .env.local and fill in. NEVER commit .env.local.

# Web app config (Firebase Console > Project settings > General > Your apps > Web app).
# These are public by design: they identify the project, they do not grant access.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sira-20fae.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sira-20fae
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Server-only secrets (Firebase Admin SDK). NO "NEXT_PUBLIC_" prefix, ever. ──
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Copy "client_email" and "private_key" from the downloaded JSON into these two lines.
# Keep the private key inside double quotes and keep the \n sequences as they are.
# Do not commit the JSON file and do not share it with anyone.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Alternative to the two lines above (local machines only): path to the downloaded JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=
