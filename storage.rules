rules_version = '2';

// SIRA — Cloud Storage rules. PREPARED FOR LATER: Storage is not enabled yet (it needs the Blaze plan).
// Deploy these only after Storage is created. Public images are readable by everyone; only staff
// (role claim set by the Admin SDK) may upload, and only images up to 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null && 'role' in request.auth.token && request.auth.token.role in ['super_admin', 'admin', 'editor'];
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    // Teacher project files: private, added in a later phase.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
